# HỌC VNWATCH — outputs/vnwatch-backend/.env.example
# Mẫu tên biến môi trường; sao chép sang .env và điền giá trị riêng khi cài mới, không đưa key vào React.
# Local development placeholders only. Use the same password in both URLs.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Development-only reset messages. Contains one-time secrets; never expose over HTTP.
RESET_MAIL_DIR=work/mail-outbox
POSTGRES_PASSWORD=replace-with-your-local-password
DATABASE_URL=postgresql://vnwatch:replace-with-your-local-password@localhost:54329/vnwatch_dev?schema=public
TEST_DATABASE_URL=postgresql://vnwatch:replace-with-your-local-password@localhost:54330/vnwatch_test?schema=public

# Optional read-only customer consultant (FastAPI); token must match agent .env.
ASSISTANT_SERVICE_URL=http://127.0.0.1:8000
ASSISTANT_SERVICE_TOKEN=
