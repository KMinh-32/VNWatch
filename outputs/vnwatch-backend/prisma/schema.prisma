  // Hồ sơ/danh tính hiện tại; quan hệ DB nếu dùng trong Prisma. @relation khai báo khóa ngoại; onDelete quyết định hành vi xóa.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Ràng buộc duy nhất cho tổ hợp cột; database chặn bản ghi trùng.
  @@unique([userId, productId])
  // Index hỗ trợ truy vấn tương ứng; vẫn cần đo/EXPLAIN để đánh giá tốc độ.
  @@index([productId, hidden, createdAt])
  // Ánh xạ model sang tên bảng trong PostgreSQL.
  @@map("product_reviews")
}
