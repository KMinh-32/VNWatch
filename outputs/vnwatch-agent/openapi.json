{
  "openapi": "3.1.0",
  "info": {
    "title": "VNWatch customer consultant",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/internal/chat": {
      "post": {
        "summary": "Chat",
        "operationId": "chat_internal_chat_post",
        "parameters": [
          {
            "name": "x-agent-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Agent-Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatReply"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Brand": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          }
        },
        "type": "object",
        "required": [
          "name",
          "summary",
          "source"
        ],
        "title": "Brand"
      },
      "ChatReply": {
        "properties": {
          "intent": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "search",
                  "product",
                  "brand",
                  "policy",
                  "guide",
                  "unsupported"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          },
          "modelName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Modelname"
          },
          "mode": {
            "type": "string",
            "enum": [
              "CATALOG",
              "OPENAI"
            ],
            "title": "Mode"
          },
          "notice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notice"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "selection": {
            "items": {
              "$ref": "#/components/schemas/Selection"
            },
            "type": "array",
            "title": "Selection"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "action": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "orders",
                  "collection",
                  "guide"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "notice",
          "text"
        ],
        "title": "ChatReply"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "maxItems": 8,
            "title": "History"
          },
          "products": {
            "items": {
              "$ref": "#/components/schemas/Product"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Products"
          },
          "brands": {
            "items": {
              "$ref": "#/components/schemas/Brand"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Brands"
          },
          "policies": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Policies"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message",
          "products",
          "brands",
          "policies"
        ],
        "title": "ChatRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Message": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "Message"
      },
      "Product": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "brand": {
            "type": "string",
            "title": "Brand"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "dataKind": {
            "type": "string",
            "enum": [
              "DEMO",
              "REFERENCE"
            ],
            "title": "Datakind"
          },
          "sourceName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourcename"
          },
          "sourceUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourceurl"
          },
          "sourceCheckedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourcecheckedat"
          },
          "variants": {
            "items": {
              "$ref": "#/components/schemas/Variant"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Variants"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "brand",
          "category",
          "description",
          "dataKind",
          "variants"
        ],
        "title": "Product"
      },
      "Selection": {
        "properties": {
          "productId": {
            "type": "string",
            "title": "Productid"
          },
          "variantIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Variantids"
          }
        },
        "type": "object",
        "required": [
          "productId",
          "variantIds"
        ],
        "title": "Selection"
      },
      "Source": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "checkedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkedat"
          }
        },
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "title": "Source"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Variant": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "priceVnd": {
            "type": "integer",
            "maximum": 2147483647,
            "minimum": 0,
            "title": "Pricevnd"
          },
          "inStock": {
            "type": "boolean",
            "title": "Instock"
          },
          "movementType": {
            "type": "string",
            "title": "Movementtype"
          },
          "caseDiameterMm": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Casediametermm"
          },
          "caseDimensionsMm": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Casedimensionsmm"
          },
          "caseMaterial": {
            "type": "string",
            "title": "Casematerial"
          },
          "crystalMaterial": {
            "type": "string",
            "title": "Crystalmaterial"
          },
          "strapMaterial": {
            "type": "string",
            "title": "Strapmaterial"
          },
          "waterResistanceM": {
            "type": "integer",
            "title": "Waterresistancem"
          },
          "warrantyMonths": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warrantymonths"
          },
          "priceSourceName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pricesourcename"
          },
          "priceSourceUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pricesourceurl"
          },
          "priceCheckedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pricecheckedat"
          }
        },
        "type": "object",
        "required": [
          "id",
          "sku",
          "label",
          "priceVnd",
          "inStock",
          "movementType",
          "caseMaterial",
          "crystalMaterial",
          "strapMaterial",
          "waterResistanceM"
        ],
        "title": "Variant"
      }
    }
  }
}
