# HỌC VNWATCH — outputs/vnwatch-agent/.env.example
# Mẫu tên biến môi trường; sao chép sang .env và điền giá trị riêng khi cài mới, không đưa key vào React.
# Server only. Never put this key in React/VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Must match the NestJS ASSISTANT_SERVICE_TOKEN (at least 32 characters).
ASSISTANT_SERVICE_TOKEN=
