# HỌC VNWATCH — .env.docker.example
# Mẫu cấu hình Docker cục bộ; .env.docker thật giữ secret và không đưa vào git.
# Local Docker demo. Run docker/setup.ps1 to generate secrets.
POSTGRES_PASSWORD=
ASSISTANT_SERVICE_TOKEN=
WEB_PORT=5180
# Optional, server only. Leave empty for catalog consultation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
