ill=0;endArrow=ERzeroToMany;endFill=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="HoiThoai" target="TinNhan"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="CHÚ GIẢI&#10;Xanh dương: bảng gốc&#10;Xanh lá: bảng chatbot mới&#10;Cam: bảng cập nhật&#10;PK: khóa chính; FK: khóa ngoại&#10;NULL: thuộc tính không bắt buộc&#10;R01–R18: mã quan hệ" style="text;html=0;fontSize=15;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1710" y="1435" width="400" height="310" as="geometry" /></mxCell><mxCell id="footer" value="Bản thiết kế gộp theo ảnh ERD; chưa áp dụng vào database. Một số độ dài kiểu dữ liệu trong ảnh gốc bị cắt đã được hoàn thiện nhất quán." style="text;html=0;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="1835" width="3100" height="50" as="geometry" /></mxCell><mxCell id="chat-note" value="CHATBOT AI&#10;TaiKhoan 0..1 — 0..N HoiThoai&#10;HoiThoai 1 — 0..N TinNhan&#10;NguoiGui: user / assistant&#10;CheDo: OPENAI / CATALOG&#10;TinNhan.MaHoiThoai: FK bắt buộc; không lặp MaTK.&#10;Chatbot đọc SanPham khi tư vấn; không tạo FK trực tiếp." style="text;html=0;fontSize=16;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2290" y="1235" width="900" height="260" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>