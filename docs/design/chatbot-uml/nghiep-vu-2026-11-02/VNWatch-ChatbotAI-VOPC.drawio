erticalAlign=top;spacing=0;fontSize=15;fontColor=#bac4cf;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1620" y="1949" width="272.2" height="24.0" as="geometry" /></mxCell><mxCell id="shape_168" value="Rxx: mã quan hệ trong ERD gộp" style="text;html=0;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#bac4cf;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1620" y="1980" width="281.34999999999997" height="24.0" as="geometry" /></mxCell><mxCell id="shape_169" value="?: thuộc tính cho phép NULL" style="text;html=0;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#bac4cf;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1620" y="2011" width="263.04999999999995" height="24.0" as="geometry" /></mxCell><mxCell id="shape_170" value="PK: khóa chính; FK: khóa ngoại" style="text;html=0;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#bac4cf;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1620" y="2042" width="290.5" height="24.0" as="geometry" /></mxCell><mxCell id="shape_171" value="PHẠM VI USE CASE" style="text;html=0;align=left;verticalAlign=top;spacing=0;fontSize=19;fontColor=#f8fafc;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="45" y="1681" width="201.44" height="30.400000000000002" as="geometry" /></mxCell><mxCell id="shape_172" value="Khách vãng lai hoặc đã đăng nhập đều được hỏi." style="text;html=0;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#bac4cf;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="45" y="1724" width="464.96" height="25.6" as="geometry" /></mxCell><mxCell id="shape_173" value="Tư vấn đồng hồ, giá, tồn kho, thương hiệu và chính sách." style="text;html=0;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#bac4cf;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="45" y="1755" width="562.56" height="25.6" as="geometry" /></mxCell><mxCell id="shape_174" value="Kiến thức chỉ được dùng khi đã được admin duyệt." style="text;html=0;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#bac4cf;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="45" y="1786" width="484.48" height="25.6" as="geometry" /></mxCell><mxCell id="shape_175" value="AI nhận dữ liệu do Controller cung cấp; không tự truy cập DB." style="text;html=0;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#bac4cf;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="45" y="1817" width="611.36" height="25.6" as="geometry" /></mxCell><mxCell id="shape_176" value="Mua hàng / giỏ hàng là use case riêng, yêu cầu đăng nhập." style="text;html=0;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#bac4cf;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="45" y="1848" width="572.3199999999999" height="25.6" as="geometry" /></mxCell><mxCell id="shape_177" value="Đọc SanPham.HinhAnh cho thẻ gợi ý; không cần truy vấn album." style="text;html=0;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#bac4cf;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="45" y="1879" width="601.6" height="25.6" as="geometry" /></mxCell><mxCell id="shape_178" value="Các thuộc tính trên lớp là phần liên quan đến use case." style="text;html=0;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#bac4cf;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="45" y="1910" width="552.8" height="25.6" as="geometry" /></mxCell><mxCell id="shape_179" value="Controller điều phối yêu cầu: các mũi tên «use» chỉ việc gọi / sử dụng Entity, không gán bội số dữ liệu cho Controller." style="text;html=0;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#f8fafc;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="45" y="2224" width="1177.44" height="25.6" as="geometry" /></mxCell><mxCell id="shape_180" value="Bội số Entity–Entity lấy từ ERD. R20 mô tả người duyệt kiến thức; thao tác duyệt thuộc use case quản trị riêng." style="text;html=0;align=left;verticalAlign=top;spacing=0;fontSize=16;fontColor=#f8fafc;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="45" y="2258" width="1099.36" height="25.6" as="geometry" /></mxCell><mxCell id="shape_181" value="Đối chiếu Sequence 01–03 đi kèm. Thiết kế lưu phiên, tin nhắn, nguồn theo ERD; chưa áp dụng migration vào database đang chạy." style="text;html=0;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#bac4cf;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="45" y="2296" width="1083.5" height="22.400000000000002" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>