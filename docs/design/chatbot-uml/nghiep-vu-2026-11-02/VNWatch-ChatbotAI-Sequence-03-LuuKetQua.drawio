ontColor=#475569;" vertex="1" parent="1"><mxGeometry x="38" y="2499" width="952.2" height="28.900000000000002" as="geometry" /></mxCell><mxCell id="s85" value="Tin AI có MaTK=NULL. CheDo và TenMoHinh lưu cùng TinNhanChat; không phải một bảng nhà cung cấp AI." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=14;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="38" y="2529" width="915.8000000000001" height="28.900000000000002" as="geometry" /></mxCell><mxCell id="s86" value="Mỗi break kết thúc toàn bộ interaction này: rollback các thay đổi trong transaction; tin khách trước đó vẫn giữ." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=14;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="38" y="2559" width="1043.2" height="28.900000000000002" as="geometry" /></mxCell><mxCell id="s87" value="Nếu BEGIN thất bại thì trả lỗi ngay. Không giữ transaction mở trong thời gian chờ AI ở Sequence 02." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=14;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="38" y="2589" width="924.9" height="28.900000000000002" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>