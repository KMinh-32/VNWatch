="1" parent="1" source="p_form" target="p_customer"><mxGeometry relative="1" as="geometry"><mxPoint x="474" y="4135" as="sourcePoint" /><mxPoint x="136" y="4135" as="targetPoint" /></mxGeometry></mxCell><mxCell id="s161" value="33. Thông báo lỗi;&#10;cho phép thử lại" style="text;html=0;align=center;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=15;fontStyle=0;fontColor=#172b43;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="144.0" y="4085.75" width="322" height="50.5" as="geometry" /></mxCell><mxCell id="s162" value="" style="rounded=0;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="22" y="4273" width="4066" height="140" as="geometry" /></mxCell><mxCell id="s163" value="Mỗi lần gửi câu hỏi chạy một interaction này; kiểm tra quyền được lặp lại, không chỉ kiểm tra lúc mở cửa sổ." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=14;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="38" y="4285" width="1006.8000000000001" height="28.900000000000002" as="geometry" /></mxCell><mxCell id="s164" value="Tin khách và câu hỏi hiện tại không bị đưa vào prompt hai lần. AI là phân hệ tư vấn, không có đường truy cập trực tiếp các Entity." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=14;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="38" y="4315" width="1207.0" height="28.900000000000002" as="geometry" /></mxCell><mxCell id="s165" value="Lỗi đọc dữ liệu / lưu câu hỏi dừng xử lý và báo lỗi; không coi lỗi truy vấn là catalog rỗng để AI tự suy diễn." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=14;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="38" y="4345" width="1025.0" height="28.900000000000002" as="geometry" /></mxCell><mxCell id="s166" value="Bản thiết kế theo ERD gộp. Sequence 03 giải thích chi tiết phần lưu; không dùng ký hiệu critical để thay cho giao dịch database." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=14;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="38" y="4375" width="1188.8" height="28.900000000000002" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="VNWatch-ChatbotAI-Sequence-03-LuuKetQua" name="04 Sequence — lưu kết quả"><mxGraphModel dx="2020" dy="2647" grid="1" gridSize="10" page="1" pageWidth="2020" pageHeight="2647" pageScale="1" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="s1" value="SEQUENCE 03 — LƯU KẾT QUẢ TƯ VẤN NHẤT QUÁN" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=25;fontStyle=1;fontColor=#172b43;" vertex="1" parent="1"><mxGeometry x="28" y="15" width="706.5" height="43.75" as="geometry" /></mxCell><mxCell id="s2" value="sd LuuKetQuaTuVan · được gọi từ ref của Sequence 02 · dùng chung transaction context cho các thao tác ghi" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=16;fontStyle=0;fontColor=#52677d;" vertex="1" parent="1"><mxGeometry x="28" y="58" width="1116.0" height="31.6" as="geometry" /></mxCell><mxCell id="p_controller" value="" style="group;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="240" height="2337" as="geometry" /></mxCell><mxCell id="s3" value="" style="ellipse;fillColor=#d5e8d4;strokeColor=#64748b;" vertex="1" parent="p_controller"><mxGeometry x="93" y="31" width="54" height="54" as="geometry" /></mxCell><mxCell id="s4" value="" style="edgeStyle=none;rounded=0;strokeColor=#94a3b8;strokeWidth=1.6;dashed=0;endArrow=none;endFill=1;startArrow=none;" edge="1" parent="p_controller"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="37" as="sourcePoint" /><mxPoint x="106" y="30" as="targetPoint" /><Array as="points"><mxPoint x="124" y="23" /></Array></mxGeometry></mxCell><mxCell id="s5" value="" styl