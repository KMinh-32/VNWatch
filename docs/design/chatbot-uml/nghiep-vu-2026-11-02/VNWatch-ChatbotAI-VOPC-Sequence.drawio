olor=#7da2c7;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="715" y="3645" width="3030" height="99" as="geometry" /></mxCell><mxCell id="s154" value="ref" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=16;fontStyle=1;fontColor=#172b43;" vertex="1" parent="1"><mxGeometry x="727" y="3653" width="55.2" height="31.6" as="geometry" /></mxCell><mxCell id="s155" value="Sequence 03 — luuKetQuaTuVan(MaPhien, ketQua)" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=15;fontStyle=0;fontColor=#172b43;" vertex="1" parent="1"><mxGeometry x="780" y="3656" width="462.75" height="30.25" as="geometry" /></mxCell><mxCell id="s156" value="Lưu TinNhanChat AI + SanPhamGoiY + NguonTraLoi + cập nhật PhienChat trong một transaction." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=15;fontStyle=0;fontColor=#172b43;" vertex="1" parent="1"><mxGeometry x="780" y="3681" width="901.5" height="30.25" as="geometry" /></mxCell><mxCell id="s157" value="Trả về: commit thành công và MaTNAI, hoặc lỗi lưu." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=15;fontStyle=0;fontColor=#172b43;" vertex="1" parent="1"><mxGeometry x="780" y="3706" width="511.5" height="30.25" as="geometry" /></mxCell><mxCell id="message_30" value="" style="edgeStyle=none;rounded=0;strokeColor=#22354b;strokeWidth=1.6;dashed=1;endArrow=open;endFill=0;startArrow=none;exitX=0.475;exitY=0.9012761858897183;entryX=0.525;entryY=0.9012761858897183;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="p_controller" target="p_form"><mxGeometry relative="1" as="geometry"><mxPoint x="824" y="3843" as="sourcePoint" /><mxPoint x="486" y="3843" as="targetPoint" /></mxGeometry></mxCell><mxCell id="s158" value="30. Câu trả lời, gợi ý, nguồn,&#10;MaTNAI và chế độ tư vấn" style="text;html=0;align=center;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=15;fontStyle=0;fontColor=#172b43;fillColo