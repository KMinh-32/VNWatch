eight="30.25" as="geometry" /></mxCell><mxCell id="message_15" value="" style="edgeStyle=none;rounded=0;strokeColor=#22354b;strokeWidth=1.6;dashed=0;endArrow=block;endFill=1;startArrow=none;exitX=0.525;exitY=0.9054343175010697;entryX=0.525;entryY=0.9182712879760376;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="p_controller" target="p_controller"><mxGeometry relative="1" as="geometry"><mxPoint x="136" y="2216" as="sourcePoint" /><mxPoint x="136" y="2246" as="targetPoint" /><Array as="points"><mxPoint x="225" y="2216" /><mxPoint x="225" y="2246" /></Array></mxGeometry></mxCell><mxCell id="s79" value="15. rollbackGiaoDich(); trả lỗi lưu cho interaction gọi" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=15;fontStyle=0;fontColor=#172b43;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="242" y="2193" width="533.5" height="30.25" as="geometry" /></mxCell><mxCell id="s80" value="" style="rounded=0;fillColor=#fffbeb;strokeColor=#c4ae69;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="24" y="2331" width="1972" height="49" as="geometry" /></mxCell><mxCell id="s81" value="Trả thành công và MaTNAI cho interaction gọi; Sequence 02 mới trả kết quả về giao diện." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=15;fontStyle=0;fontColor=#172b43;" vertex="1" parent="1"><mxGeometry x="39" y="2342" width="872.25" height="30.25" as="geometry" /></mxCell><mxCell id="s82" value="" style="rounded=0;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="22" y="2457" width="1976" height="170" as="geometry" /></mxCell><mxCell id="s83" value="SanPhamGoiY: PK(MaTN, MaSP), ThuTu &gt; 0; mỗi MaTN không trùng ThuTu. MaTN ở đây luôn là MaTNAI." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=14;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="38" y="2469" width="879.4" height="28.900000000000002" as="geometry" /></mxCell><mxCell id="s84" value="NguonTraLoi.MaKT có thể NULL với nguồn trang sản phẩm; giữ tiêu đề, URL và bản chụp nội dung theo ERD." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=14;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="38" y="2499" width="952.2" height="28.900000000000002" as="geometry" /></mxCell><mxCell id="s85" value="Tin AI có MaTK=NULL. CheDo và TenMoHinh lưu cùng TinNhanChat; không phải một bảng nhà cung cấp AI." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=14;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="38" y="2529" width="915.8000000000001" height="28.900000000000002" as="geometry" /></mxCell><mxCell id="s86" value="Mỗi break kết thúc toàn bộ interaction này: rollback các thay đổi trong transaction; tin khách trước đó vẫn giữ." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=14;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="38" y="2559" width="1043.2" height="28.900000000000002" as="geometry" /></mxCell><mxCell id="s87" value="Nếu BEGIN thất bại thì trả lỗi ngay. Không giữ transaction mở trong thời gian chờ AI ở Sequence 02." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=wrap;fontSize=14;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="38" y="2589" width="924.9" height="28.900000000000002" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="vopc-dark" name="01b VOPC nền tối"><mxGraphModel dx="3600" dy="2350" grid="1" gridSize="10" page="1" pageWidth="3600" pageHeight="2350" pageScale="1" background="#111417"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="background" value="" style="rounded=0;fillColor=#111417;strokeColor=none;locked=1;movable=0;resizable=0;selectable=0;connectable=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="3600" height="2350" as="geometry" />