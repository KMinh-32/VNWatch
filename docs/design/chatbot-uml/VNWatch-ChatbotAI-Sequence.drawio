002" height="27.32" as="geometry" /></mxCell><mxCell id="shape_105" value="" style="edgeStyle=none;rounded=0;strokeColor=#334155;strokeWidth=1.7;dashed=1;endArrow=open;endFill=0;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="3110" as="sourcePoint" /><mxPoint x="130" y="3110" as="targetPoint" /></mxGeometry></mxCell><mxCell id="shape_106" value="Hiển thị lỗi / nút thử lại" style="text;html=0;align=center;verticalAlign=top;fontSize=14;fontColor=#334155;fontStyle=0;whiteSpace=wrap;spacing=0;labelBackgroundColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="176.51999999999998" y="3083" width="256.96000000000004" height="27.32" as="geometry" /></mxCell><mxCell id="shape_107" value="" style="rounded=1;arcSize=5;fillColor=#fff4d6;strokeColor=#d6b656;html=0;" vertex="1" parent="1"><mxGeometry x="55" y="3230" width="2410" height="118" as="geometry" /></mxCell><mxCell id="shape_108" value="T1 / T2 là các transaction ngắn; không giữ transaction trong lúc gọi AI. Chỉ trả thành công sau khi T2 COMMIT." style="text;html=0;align=left;verticalAlign=top;fontSize=15;fontColor=#1e293b;fontStyle=1;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="75" y="3245" width="1080.0" height="28.7" as="geometry" /></mxCell><mxCell id="shape_109" value="Nếu T2 lỗi: rollback, trả lỗi lưu dữ liệu; không báo câu trả lời đã lưu thành công. Khách không có quyền thì dừng tại khung break." style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontColor=#1e293b;fontStyle=0;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="75" y="3276" width="1188.8" height="27.32" as="geometry" /></mxCell><mxCell id="shape_110" value="Không có sản phẩm / kiến thức phù hợp: hỏi rõ thêm hoặc nói chưa có dữ liệu; không tạo sản phẩm hay nguồn giả." style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontColor=#1e293b;fontStyle=0;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="75" y="3306" width="1009.6" height="27.32" as="geometry" /></mxCell><mxCell id="shape_111" value="Thiết kế theo ERD mới; ghi lịch sử / kiến thức DB chưa được triển khai trong mã nguồn hiện tại. OpenAI chỉ lập Plan, ứng dụng dựng nội dung từ dữ liệu." style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontColor=#64748b;fontStyle=0;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="55" y="3372" width="1376.96" height="27.32" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>